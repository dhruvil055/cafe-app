PORT=5000
NODE_ENV=staging
MONGO_URI=mongodb+srv://<staging-user>:<password>@<staging-cluster>.mongodb.net/brewhaus_staging?retryWrites=true&w=majority
JWT_SECRET=<unique-staging-secret-at-least-32-characters>
TABLE_QR_SECRET=<unique-staging-qr-secret-at-least-32-characters>
RAZORPAY_KEY_ID=rzp_test_<staging-key>
RAZORPAY_KEY_SECRET=<staging-razorpay-secret>
RAZORPAY_WEBHOOK_SECRET=<staging-webhook-secret>
STAGING_ALLOWED_ORIGINS=https://staging-cafe.example.com,https://staging-admin.example.com
CLIENT_URL=https://staging-cafe.example.com
ADMIN_APP_URL=https://staging-admin.example.com
SERVER_URL=https://staging-api.example.com
GSTIN=<staging-gstin-or-empty>
ADMIN_SETUP_SECRET=<unique-staging-setup-secret-at-least-32-characters>
DINING_SESSION_IDLE_MINUTES=30
DINING_SESSION_MAX_MINUTES=240
ALLOW_PRODUCTION_SEED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@brewhauscafe.com
