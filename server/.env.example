PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cafe_db?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here_min_32_chars
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
CLIENT_URL=https://your-customer-domain.vercel.app
# Optional comma-separated exact origins, useful for production plus a preview URL.
# CLIENT_URLS=https://client-seven-sigma-26.vercel.app,https://preview.example.com
SERVER_URL=https://your-api-domain.onrender.com
NODE_ENV=development
ADMIN_SETUP_SECRET=your_setup_secret_here_min_32_chars
# Local/demo only. Never enable this on a real payment deployment.
DEMO_PAYMENTS_ENABLED=false
DINING_SESSION_IDLE_MINUTES=30
DINING_SESSION_MAX_MINUTES=240
