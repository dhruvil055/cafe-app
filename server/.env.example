PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cafe_db?retryWrites=true&w=majority
TENANT_DEFAULT_SLUG=brewhaus
# Set this to the shared customer domain to enable café subdomains such as slug.yourdomain.com.
# TENANT_BASE_DOMAIN=yourdomain.com
JWT_SECRET=your_jwt_secret_here_min_32_chars
# 32 random bytes, base64 encoded; used to encrypt each tenant's Razorpay secrets. Keep stable and back it up securely.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TENANT_CREDENTIALS_ENCRYPTION_KEY=replace_with_32_byte_base64_key
TABLE_QR_SECRET=your_table_qr_signing_secret_min_32_chars
CLIENT_URL=https://cafe.infinigrowsoftech.com
# Optional exact origin lists are for staging only.
# STAGING_ALLOWED_ORIGINS=https://staging-cafe.example.com,https://staging-admin.example.com
# Production CORS permits the existing customer/admin domains and configured one-label tenant customer subdomains.
SERVER_URL=https://your-api-domain.onrender.com
GSTIN=
NODE_ENV=development
ADMIN_SETUP_SECRET=your_setup_secret_here_min_32_chars
DINING_SESSION_IDLE_MINUTES=30
DINING_SESSION_MAX_MINUTES=240
# Guard preventing accidental database seeding against production databases
ALLOW_PRODUCTION_SEED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@brewhauscafe.com
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_min_32_chars
SUPER_ADMIN_EMAIL=admin@brewhaus.com
SUPER_ADMIN_PASSWORD=
# Optional: Sentry error tracking
# SENTRY_DSN=https://<key>@sentry.io/<project>
# Optional: Cloudinary for persistent image storage
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
