# ── SERVER & RUNTIME ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── PROXY & TRUST SETTINGS ─────────────────────────────────────────────────
# Render terminates TLS and acts as 1 proxy hop. Set to 1 on bare Render.
# If using Cloudflare in front of Render (Orange cloud), set to 2.
TRUST_PROXY_HOPS=1

# ── DATABASE (MongoDB Atlas) ───────────────────────────────────────────────
# Dedicated DB user with readWrite on brewhaus database only.
# Ensure network access whitelist on Atlas includes 0.0.0.0/0 (or Render egress IPs)
MONGO_URI=mongodb+srv://<production-user>:<password>@<production-cluster>.mongodb.net/brewhaus?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000

# ── REDIS (Render Key Value or Upstash) ────────────────────────────────────
# TLS connection string (rediss:// for encrypted transport)
REDIS_URL=rediss://default:<password>@<host>:<port>

# ── RATE LIMITING ──────────────────────────────────────────────────────────
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1500
PUBLIC_RATE_LIMIT_MAX=1500
AUTH_RATE_LIMIT_MAX=20
SENSITIVE_RATE_LIMIT_MAX=60

# ── AUTHENTICATION & SECRETS ───────────────────────────────────────────────
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=<unique-production-secret-at-least-32-characters>
TABLE_QR_SECRET=<unique-production-qr-secret-at-least-32-characters>
ADMIN_SETUP_SECRET=<unique-production-setup-secret-at-least-32-characters>

# ── TENANCY & DOMAINS ──────────────────────────────────────────────────────
TENANT_BASE_DOMAIN=infinigrowsoftech.com
TENANT_DEFAULT_SLUG=brewhaus
CLIENT_URL=https://cafe.infinigrowsoftech.com
CUSTOMER_APP_URL=https://cafe.infinigrowsoftech.com
ADMIN_APP_URL=https://admin-cafe.infinigrowsoftech.com
ADMIN_CLIENT_URL=https://admin-cafe.infinigrowsoftech.com
SERVER_URL=https://cafe-app-n8mn.onrender.com

# ── PAYMENTS (Razorpay Live) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_<production-key>
RAZORPAY_KEY_SECRET=<production-razorpay-secret>
RAZORPAY_WEBHOOK_SECRET=<production-webhook-secret>

# ── CAFE DEFAULTS ──────────────────────────────────────────────────────────
GSTIN=<cafe-registered-gstin>
DINING_SESSION_IDLE_MINUTES=30
DINING_SESSION_MAX_MINUTES=240
ALLOW_PRODUCTION_SEED=false

# ── PUSH NOTIFICATIONS (Web Push VAPID) ────────────────────────────────────
VAPID_PUBLIC_KEY=<production-vapid-public-key>
VAPID_PRIVATE_KEY=<production-vapid-private-key>
VAPID_SUBJECT=mailto:admin@brewhauscafe.com

# ── DIAGNOSTICS & TELEMETRY ────────────────────────────────────────────────
# Set to 'true' only temporarily to debug proxy hops; otherwise leave false
DEBUG_IP_ENDPOINT=false
DEBUG_IP_SECRET=<optional-secret-for-diagnostic-endpoint>
SENTRY_DSN=
CLOUDINARY_URL=
